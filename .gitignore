## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/
*.sln.iml

# User secrets
appsettings.*.json
!appsettings.json
!appsettings.Development.json
secrets.json

# Database files
*.db
*.db-shm
*.db-wal

# Environment variables
.env
.env.local
.env.production

# NuGet Packages
*.nupkg
**/packages/*

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React production build
build/
dist/

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log